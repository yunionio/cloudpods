ARG FILE_REPO_TAG=v0.5.15

# https://github.com/yunionio/telegraf/blob/yn-release-1.36/Makefile.yn#L28
# install playbook and telegraf install pkg
FROM registry.cn-beijing.aliyuncs.com/yunionio/file-repo:${FILE_REPO_TAG} AS file-repo

FROM registry.cn-beijing.aliyuncs.com/yunionio/ansibleserver-base:3.22.2-0

#COPY --from=file-repo /opt/yunion/playbook /opt/yunion/playbook
COPY --from=file-repo /opt/yunion/ansible-install-pkg /opt/yunion/ansible-install-pkg

RUN mkdir -p /opt/yunion/playbook
RUN git clone -b master https://github.com/yunionio/monitor-agent.git /opt/yunion/playbook/monitor-agent --recurse-submodules

ADD ./_output/alpine-build/bin/ansibleserver /opt/yunion/bin/ansibleserver
